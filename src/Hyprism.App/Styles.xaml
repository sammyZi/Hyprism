<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Hyprism's own window colors instead of the Windows default (Mica/system grey).
        AppBackground: title bar + navigation pane.  AppLayer: the raised content surface.
        The NavigationView keys below are its lightweight-styling hooks, so the built-in control picks these up.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="AppBackgroundColor">#0F1015</Color>
            <Color x:Key="AppLayerColor">#16171E</Color>
            <Color x:Key="AppLayerBorderColor">#14FFFFFF</Color>
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="AppLayerBrush" Color="{StaticResource AppLayerColor}" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{StaticResource AppLayerColor}" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="{StaticResource AppLayerBorderColor}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="AppBackgroundColor">#ECE9E4</Color>
            <Color x:Key="AppLayerColor">#F8F6F2</Color>
            <Color x:Key="AppLayerBorderColor">#12000000</Color>
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="AppLayerBrush" Color="{StaticResource AppLayerColor}" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{StaticResource AppLayerColor}" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="{StaticResource AppLayerBorderColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Google Sans Flex everywhere: every built-in control reads its font from these keys. -->
    <FontFamily x:Key="HyprismFont">ms-appx:///Assets/Fonts/GoogleSansFlex.ttf#Google Sans Flex</FontFamily>
    <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/GoogleSansFlex.ttf#Google Sans Flex</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <!-- Nerd Font icons come from the bundled symbols font, never from Windows' font fallback: a broken system font
         registration (e.g. "Holo MDL2 Assets" left behind without its file) makes that fallback crash the whole app. -->
    <FontFamily x:Key="NerdFont">Cascadia Mono, ms-appx:///Assets/Fonts/SymbolsNerdFontMono-Regular.ttf#Symbols Nerd Font Mono, Consolas</FontFamily>

    <!-- Type ramp. Slightly tighter and heavier than Segoe so the flex face reads well. -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HyprismFont}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="TextLineBounds" Value="Tight" />
    </Style>
    <Style x:Key="SectionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HyprismFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="2,28,0,8" />
    </Style>
    <Style x:Key="MutedStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HyprismFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="EyebrowStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HyprismFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
    </Style>

    <!-- Surfaces -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <x:Double x:Key="ContentMaxWidth">1040</x:Double>
    <Thickness x:Key="PagePadding">40,28,40,40</Thickness>
</ResourceDictionary>
