<Window
    x:Class="Hyprism.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Hyprism">

    <Grid x:Name="Root" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: app mark, name, and the active profile. -->
        <Grid x:Name="AppTitleBar" Padding="18,0,150,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/Hyprism.png" Width="18" Height="18" />
                <TextBlock Text="Hyprism" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border x:Name="ProfileChip" Visibility="Collapsed" Padding="8,2" CornerRadius="10" VerticalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <TextBlock x:Name="ProfileLabel" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
                <Border x:Name="PerfChip" Visibility="Collapsed" Padding="8,2" CornerRadius="10" VerticalAlignment="Center"
                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                    <TextBlock Text="Performance mode" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1"
                        PaneDisplayMode="Left" OpenPaneLength="240"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="True"
                        IsTitleBarAutoPaddingEnabled="False"
                        SelectionChanged="Nav_SelectionChanged">
            <!-- Pages animate their own sections in (PageBase); motion runs on the compositor. -->
            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- In-app notifications, bottom right. -->
        <StackPanel x:Name="Toasts" Grid.Row="1" Width="380" Spacing="8" Margin="24"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" />
    </Grid>
</Window>
